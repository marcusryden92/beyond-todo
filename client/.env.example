# Copy this file to `.env` and set your API URL.
# Vite only exposes variables prefixed with VITE_, and inlines them at build time.

# Local backend:
VITE_SERVER_URL=http://localhost:3000

# In production (e.g. Vercel), set this to your deployed backend URL, no trailing slash:
# VITE_SERVER_URL=https://beyond-todo-api.onrender.com
