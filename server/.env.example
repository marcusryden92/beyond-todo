# Copy this file to `.env` and fill in your values.
# Loaded by api/db.js and api/models/initDb.js via dotenv.

# --- PostgreSQL connection ---
DBUSERNAME=postgres
PASSWORD=your_password_here
HOST=localhost
DBPORT=5432
# Note: the database name itself ("group5") is hard-coded in api/db.js.

# --- Express server ---
PORT=3000

# --- CORS: the URL the client (Vite) runs on ---
ORIGINURL=http://localhost:5173
