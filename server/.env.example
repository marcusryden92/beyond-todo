# Copy this file to `.env` and fill in your values.
# Loaded by api/db.js, api/express.js, and api/models/initDb.js via dotenv.

# --- PostgreSQL (Neon or local) ---
# Neon: copy the "Pooled connection" string from your project dashboard.
# Local: postgresql://USER:PASSWORD@localhost:5432/group5
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Express server ---
PORT=3000
# Set to "production" on your host (Render). Controls secure/cross-site cookies.
NODE_ENV=development

# --- Session ---
# Any long random string. Generate one with:  openssl rand -hex 32
SESSION_SECRET=replace_with_a_long_random_string

# --- CORS ---
# The URL(s) the frontend is served from. Comma-separate multiple (dev + prod).
# No trailing slash.
ORIGINURL=http://localhost:5173
